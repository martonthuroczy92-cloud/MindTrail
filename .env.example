# Copy to .env.local for local development (`vercel env pull .env.local` does this for you).
# In production every value lives in Vercel → Project → Settings → Environment Variables.

# --- Set by the Vercel ↔ Supabase integration (names may vary; the code accepts the aliases) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=            # public; the only key that goes into the browser bundle
SUPABASE_SERVICE_ROLE_KEY=    # SECRET; server only, bypasses RLS

# --- You set these ---
OWNER_EMAIL=you@example.com   # the only address that can sign in
RESEND_API_KEY=               # SECRET; sends the magic-link email
MAIL_FROM=MindTrail <onboarding@resend.dev>
TRANSCRIBE_MODEL=openai/whisper-1
# APP_URL=https://your-app.vercel.app   # optional; defaults to the production URL Vercel provides

# --- Local development only (on Vercel the AI Gateway authenticates via OIDC automatically) ---
AI_GATEWAY_API_KEY=           # SECRET
